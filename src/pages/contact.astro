---
import AsciiDivider from "@/components/ascii-divider.astro";
import { ContactForm } from "@/components/contact-form";
import BaseLayout from "@/layouts/base-layout.astro";
import { LINKS } from "@/constants/links";
import { UTM_PARAMS } from "@/constants/site";
import { addQueryParams } from "@/lib/url";
---

<BaseLayout
  title="Contact"
  description="Get in touch with Shadcn Labs — send a message or reach us by email and Discord."
>
  <AsciiDivider />

  <section id="contact" class="view-container">
    <h2>
      <a href="#contact" class="view-container-title">CONTACT</a>
    </h2>
    <p class="text-muted-foreground">
      Send a message using the form, or reach out directly.
    </p>

    <ContactForm client:load />

    <p class="mt-6">
      Or email <a href={`mailto:${LINKS.EMAIL}`}>{LINKS.EMAIL}</a> or <a
        target="_blank"
        href={addQueryParams(LINKS.DISCORD, UTM_PARAMS)}>join our Discord</a
      >.
    </p>
  </section>
</BaseLayout>
